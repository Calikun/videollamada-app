{
  "dashboard": {
    "id": null,
    "title": "Ensigna.corp Monitoring",
    "tags": ["ensigna", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Active Rooms and Participants",
        "type": "graph",
        "targets": [
          {
            "expr": "ensigna_active_rooms",
            "legendFormat": "Active Rooms"
          },
          {
            "expr": "ensigna_active_participants",
            "legendFormat": "Active Participants"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "System Resources",
        "type": "graph",
        "targets": [
          {
            "expr": "ensigna_cpu_usage_percent",
            "legendFormat": "CPU %"
          },
          {
            "expr": "ensigna_memory_usage_percent",
            "legendFormat": "Memory %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "WebRTC Quality",
        "type": "graph",
        "targets": [
          {
            "expr": "ensigna_video_quality_score",
            "legendFormat": "Video Quality"
          },
          {
            "expr": "ensigna_audio_quality_score",
            "legendFormat": "Audio Quality"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Network and Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "ensigna_network_bandwidth_mbps",
            "legendFormat": "Bandwidth (Mbps)"
          },
          {
            "expr": "histogram_quantile(0.95, rate(ensigna_webrtc_latency_ms_bucket[5m]))",
            "legendFormat": "95th percentile latency (ms)"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}